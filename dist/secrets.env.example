# =============================================================================
# 内网部署 · 环境变量模板
# 用法：cp secrets.env.example ../secrets.env  →  填值  →  sudo bash install.sh
# =============================================================================

# ----- 必填（5 项）--------------------------------------------------------------

# 内网 API 域名（员工浏览器中的 api 参数，最终拼到前端 URL）
INTERNAL_API_DOMAIN=dashboard-api.corp.local

# 内网前端域名（员工实际访问的网址，公司 DNS 需解析到本机 IP）
INTERNAL_FRONT_DOMAIN=dashboard.corp.local

# JWT 签名密钥 · 必填且唯一 · 生成：openssl rand -hex 48（96 字符）
JWT_SECRET=

# HQ 管理员工号（首登会强制改密，建议实际人事工号）
ADMIN_EMP_NO=boss001

# HQ 管理员初始密码 · 生成：openssl rand -hex 12（24 字符）
ADMIN_PASSWORD=

# ----- 可选（不填会自动生成并打印一次）------------------------------------------

# 导入接口令牌（POST /api/import/* 必填头 X-Import-Token）
# IMPORT_TOKEN=

# API 端口（默认 3777）
# PORT=3777

# SQLite 文件目录（默认 /opt/dashboard/data，v4.13 已迁出 server/）
# DATA_DIR=/opt/dashboard/data

# npm 镜像源（默认 npmmirror；内网可改成自家仓库地址）
# NPM_REGISTRY=https://registry.npmmirror.com

# Node 安装脚本 URL（内网可改成自家 NodeSource 镜像的 setup 脚本地址）
# NODE_SETUP_URL=https://deb.nodesource.com/setup_20.x