# Dashboard 后端环境变量样例（部署时复制为 .env 并按需修改）
# 启动顺序：dotenv 自动从当前工作目录加载 .env，未设置时退回 process.env

# ====== v4.2 新增：JWT 鉴权 ======
# 必须设置；启动时未设置会打印高优先级 warn 并使用不安全的默认值
# 生成强随机密钥：node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-hex-string-min-64-chars

# ====== 已有配置 ======
# HTTP 监听端口
PORT=3777

# 导入接口的运维 Token（X-Import-Token），与登录体系并存，运维紧急导入通道
IMPORT_TOKEN=change-me-to-a-long-random-string

# SQLite 数据目录（容器挂载/多环境隔离）；留空则使用 server/data/
# DATA_DIR=/srv/dashboard-data

# 跨域白名单追加（逗号分隔；含 * 表示完全放开；前缀 * 表示通配）
# ALLOW_ORIGINS=https://your-domain.com,http://10.0.0.5:8080