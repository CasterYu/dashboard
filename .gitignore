# 操作系统
.DS_Store
Thumbs.db
desktop.ini

# 编辑器
.vscode/
.idea/
*.swp
*.swo
*~

# 日志
*.log
npm-debug.log*

# 临时文件
*.tmp
*.bak
*.cache
node_modules/

# 本地推送脚本中的敏感信息（避免误提交token）
push-config.local.ps1
.github-token

# 让 archive/、backups/ 不被跟踪
archive/
backups/

# v3.8 后端：SQLite 数据库文件（含 WAL 副本）不入库
server/data/
*.db-wal
*.db-shm

# playwright-cli 临时页签/控制台输出
.playwright-cli/
server/.playwright-cli/

# v4.2 后端环境变量（含 JWT_SECRET / IMPORT_TOKEN，绝不入库）
.env
server/.env
*.env.local

# v5.4 收尾：一次性勘察脚本与临时产物（禁止再污染 git status）
_tmp_*

# v5.4 收尾：会话验证截图仅本地留档，不作为交付物入库
_artifacts/
shot_*.png
.codebuddy-drill-debug.png

# v5.4 收尾：本地版本快照（README《本地版本快照工作流》：快照不进版本控制，仓库仅保留 index.html 与 legacy/v1/）
legacy/index_v*.html
legacy/_archive/